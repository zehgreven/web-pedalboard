{
  "name": "guitar-pedalboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n RENDERER,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && cp electron/carla-bridge.py dist-electron/carla-bridge.py && cross-env VITE_DEV_SERVER_URL=http://localhost:5173/ electron .\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:renderer": "cross-env VITE_ELECTRON=true vite build",
    "build:electron-main": "tsc -p tsconfig.electron.json && cp electron/carla-bridge.py dist-electron/carla-bridge.py",
    "build:electron": "npm run build:renderer && npm run build:electron-main",
    "dist": "npm run build:electron && electron-builder --config electron-builder.yml",
    "dist:linux": "npm run build:electron && electron-builder --linux --config electron-builder.yml",
    "dist:mac": "npm run build:electron && electron-builder --mac --config electron-builder.yml",
    "dist:win": "npm run build:electron && electron-builder --win --config electron-builder.yml",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}